# Segredos das Edge Functions. Preencha no arquivo supabase/.env (não versionado)
# ou use `supabase secrets set NOME=valor`.
#
# Encontre as credenciais em:
# https://www.mercadopago.com.br/developers/panel/app
# Selecione a aplicação > Credenciais > ambiente Teste ou Produção.
#
# O Webhook Secret é gerado em:
# Aplicação > Webhooks > Configurar notificações > salvar > revelar assinatura secreta.

MERCADOPAGO_ENVIRONMENT=sandbox

# Credenciais do ambiente selecionado (sandbox ou produção).
# Use os nomes com sufixo para manter os dois ambientes no mesmo projeto:

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Opcionais: sobrescrevem as credenciais acima quando o ambiente correspondente
# está ativo. Permitem trocar sandbox/produção sem apagar as demais.
MERCADOPAGO_ACCESS_TOKEN_SANDBOX=
MERCADOPAGO_PUBLIC_KEY_SANDBOX=
MERCADOPAGO_WEBHOOK_SECRET_SANDBOX=

MERCADOPAGO_ACCESS_TOKEN_PRODUCTION=
MERCADOPAGO_PUBLIC_KEY_PRODUCTION=
MERCADOPAGO_WEBHOOK_SECRET_PRODUCTION=

# URL pública do frontend usada nos retornos do Checkout Pro.
APP_PUBLIC_URL=https://startupcortex-hallen.github.io/bompapoxa

# Opcional. Se vazio, a função usa SUPABASE_URL + /functions/v1/mercadopago-webhook.
MERCADOPAGO_WEBHOOK_URL=
