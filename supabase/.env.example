# Segredos das Edge Functions. Preencha no arquivo supabase/.env (não versionado)
# ou use `supabase secrets set NOME=valor`.
#
# A InfinitePay não oferece ambiente sandbox. Os links gerados são reais; use
# valores baixos para homologar e estorne pelo app/conta web.
#
# A API Key é criada em:
# App InfinitePay > Vendas > Checkout > Configurações > Habilitar Checkout Integrado.
# Copie a InfiniteTag (sem o "$") e a API Key (começa com inchk_).

INFINITEPAY_HANDLE=
INFINITEPAY_API_KEY=

# URL pública do frontend usada no retorno do checkout.
APP_PUBLIC_URL=https://startupcortex-hallen.github.io/bompapoxa

# Opcional. Se vazio, a função usa SUPABASE_URL + /functions/v1/infinitepay-webhook.
INFINITEPAY_WEBHOOK_URL=
